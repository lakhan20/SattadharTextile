# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Public HTTPS origin used to build PDF / image URLs (Cloudflare Tunnel in prod)
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated. Expo dev client + tunnel origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:123456789@localhost:5432/sattadhar?schema=public

# ── Auth ─────────────────────────────────────────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-48-byte-random-string
JWT_REFRESH_SECRET=replace-with-a-different-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Shop defaults (seeded into shop_settings) ────────────
SHOP_NAME=Sattadhar Textile
SHOP_STATE=Gujarat
SHOP_GSTIN=24ABCDE1234F1Z5
SHOP_PHONE=+91XXXXXXXXXX
DEFAULT_LANGUAGE=EN
TZ=Asia/Kolkata

# ── Seed admin (first boot only) ─────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Shop Owner
# Password given to the three sample STAFF accounts on first seed
SEED_STAFF_PASSWORD=Staff@123

# ── Email (Brevo SMTP or any SMTP) ───────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sattadhar Textile <billing@example.com>"

# ── SMS (stub — plug a provider later) ───────────────────
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER_ID=

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Backup (scripts/backup.sh) ───────────────────────────
BACKUP_DIR=/var/backups/sattadhar
BACKUP_GPG_PASSPHRASE=replace-me
BACKUP_RETENTION_DAYS=14
RCLONE_REMOTE=offsite:sattadhar-backups
